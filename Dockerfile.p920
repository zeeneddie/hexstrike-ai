# P920 image for HexStrike AI — Kali base so the security tools actually resolve.
# The upstream/netcuter Dockerfile targets python:3.11-slim, where nikto/gobuster
# (and most of the 150 tools) are NOT in Debian repos. Kali rolling has them.
FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app

# System security tools (Kali repos). Extend this list to widen tool coverage.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv python3-dev \
    build-essential pkg-config libffi-dev libssl-dev \
    nmap nikto gobuster dirb hydra sqlmap \
    whatweb wafw00f curl git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Python deps. Kali marks the env externally-managed -> break-system-packages.
# ML deps are best-effort (heavy: angr/pwntools); core (flask/fastmcp) must succeed.
COPY requirements.txt .
RUN pip install --no-cache-dir --break-system-packages -r requirements.txt
COPY requirements-ml.txt .
RUN pip install --no-cache-dir --break-system-packages -r requirements-ml.txt || true

COPY . .

EXPOSE 8888
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8888/health || exit 1

CMD ["python3", "hexstrike_server.py", "--port", "8888"]
